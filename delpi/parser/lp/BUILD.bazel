load("//tools:cpplint.bzl", "cpplint")
load("//tools:rules_cc.bzl", "delpi_cc_library", "delpi_hdrs_tar", "delpi_srcs")

package(default_visibility = [
    "//delpi:__subpackages__",
    "//pydelpi:__subpackages__",
    "//tests:__subpackages__",
])

delpi_srcs(name = "srcs")

delpi_hdrs_tar(
    name = "hdrs_tar",
    subfolder = "lp",
)

cpplint()

delpi_cc_library(
    name = "lp_types",
    srcs = [
        "OptType.cpp",
        "SenseType.cpp",
    ],
    hdrs = [
        "OptType.h",
        "SenseType.h",
    ],
    implementation_deps = [
        "//delpi/util:error",
        "//delpi/util:strings",
    ],
    deps = ["//delpi/util:logging"],
)

delpi_cc_library(
    name = "lp_data",
    srcs = [
        "Column.cpp",
        "Row.cpp",
    ],
    hdrs = [
        "Column.h",
        "Row.h",
    ],
    implementation_deps = ["//delpi/util:error"],
    deps = [
        ":lp_types",
        "//delpi/libs:gmp",
        "//delpi/symbolic:variable",
        "//delpi/util:logging",
    ],
)

delpi_cc_library(
    name = "lp",
    srcs = [
        "Driver.cpp",
        "Scanner.cpp",
        "Scanner.h",
    ],
    hdrs = ["Driver.h"],
    implementation_deps = [
        "//delpi/parser:scanner",
        "//delpi/parser:sources",
        "//delpi/util:error",
        "//delpi/util:logging",
        "//delpi/util:strings",
    ],
    deps = [
        ":lp_data",
        "//delpi/libs:gmp",
        "//delpi/parser:driver",
        "//delpi/solver:lp_solver",
    ] + select({
        "//tools:python_build": ["//pydelpi:interrupt"],
        "//conditions:default": [],
    }),
)
