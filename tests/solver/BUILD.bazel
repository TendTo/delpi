"""Tests for the solver submodule."""

load("//tools:rules_cc.bzl", "delpi_cc_googletest")

delpi_cc_googletest(
    name = "test_lp_solver",
    tags = ["solver"],
    deps = [
        "//delpi/solver:lp_solver",
        "//tests:test_utils",
    ],
)

delpi_cc_googletest(
    name = "test_lp_solver_mps",
    data = glob(["mps/*.mps"]),
    tags = ["solver"],
    deps = [
        "//delpi/solver:lp_solver",
        "//tests:test_utils",
    ],
)

delpi_cc_googletest(
    name = "test_delpi_lp_solver",
    data = glob(["mps/*.mps"]),
    tags = ["solver"],
    deps = [
        "//delpi/libs:eigen",
        "//delpi/solver:lp_solver",
        "//delpi/solver/internal:basis",
        "//delpi/solver/internal:lp_problem",
    ],
)

delpi_cc_googletest(
    name = "test_basis",
    tags = ["solver"],
    deps = ["//delpi/solver/internal:basis"],
)

delpi_cc_googletest(
    name = "test_retriangularisation_factor",
    tags = ["solver"],
    deps = [
        "//delpi/solver/internal:retriangularisation_factor",
        "//delpi/util:exception",
    ],
)

delpi_cc_googletest(
    name = "test_bg_linear_system_solver",
    tags = ["solver"],
    deps = [
        "//delpi/solver/internal:linear_system_solver",
        "//delpi/util:error",
    ],
)
